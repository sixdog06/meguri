# 复制为 .env.local 并填入真实 key（.env.local 已 gitignore，勿提交）。
# docker compose 的 backend 服务经 env_file 读取；本地 dev.sh 同样生效。

MEGURI_OPENAI_API_KEY=
MEGURI_OPENAI_BASE_URL=https://api.kimi.com/coding/v1
MEGURI_OPENAI_MODEL=kimi-for-coding

# 可选：embedding 独立端点（默认与上面 chat LLM 同端点）。
# 推荐本地 Ollama bge-m3（免费/离线，中日文混合检索好）：
#   brew install ollama && ollama serve &  然后  ollama pull bge-m3
# MEGURI_EMBEDDING_BASE_URL=http://localhost:11434/v1
# MEGURI_EMBEDDING_API_KEY=ollama
# MEGURI_EMBEDDING_MODEL=bge-m3
# MEGURI_EMBEDDING_DIM=1024
# 不配 embedding 且上面 key 为空时：回退确定性哈希向量（检索无语义）
